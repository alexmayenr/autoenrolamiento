# Copia este archivo como .env.local para desarrollo local (vercel dev).
# En producción, estas variables se configuran en el dashboard de Vercel:
# Project → Settings → Environment Variables.
#
# NUNCA subas el archivo .env real al repositorio.

# --- Credenciales de partner (certificador FEL) ---
PARTNER_PREFIJO=IMPLEMENTACIONES_AE
PARTNER_LLAVE=coloca_aqui_la_llave_de_partner

# --- Credencial del signer (registro de certificados) ---
SIGNER_LLAVE_ACCESO=coloca_aqui_la_llave_de_acceso_del_signer

# --- Token de acceso opcional (defensa en profundidad) ---
# Si lo defines, las funciones exigen el header x-app-token con este
# mismo valor. Debes poner el MISMO valor en la constante
# APP_ACCESS_TOKEN dentro de index.html. Déjalo sin definir para
# desactivar esta verificación.
# APP_ACCESS_TOKEN=un_valor_largo_y_aleatorio
