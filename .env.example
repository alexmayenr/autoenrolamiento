# Copiar a .env.local para desarrollo (vercel dev). En producción, configurar
# en Vercel → Settings → Environment Variables. NUNCA subir el .env real.

# Firma de las cookies de sesión (valor aleatorio largo):
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=coloca_un_valor_aleatorio_largo

# Conexión a Supabase (proyecto tacticalboard). La SERVICE KEY hace bypass de
# RLS: es secreta, solo vive en el servidor, nunca en el navegador.
SUPABASE_URL=https://yiuetruckmygkbirniic.supabase.co
SUPABASE_SERVICE_KEY=coloca_la_service_role_key_de_supabase

# Llave del signer para modo REAL (no se usa en modo demo). Compartida:
# SIGNER_LLAVE=...
